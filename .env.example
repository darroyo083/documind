# Application
APP_NAME=DocuMind
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind
DATABASE_URL_SYNC=postgresql://documind:documind@localhost:5432/documind

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_DIMENSION=384
DEEPSEEK_BASE_URL=https://api.deepseek.com
PROVIDER_TIMEOUT_SECONDS=30
GENERATION_STALE_AFTER_SECONDS=900
RETRIEVAL_MAX_TOP_K=10
MAX_QUESTION_LENGTH=1000

# AI Generation Provider (deepseek, mock)
GENERATION_PROVIDER=mock
GENERATION_MODEL=mock-model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# AI Embedding Provider (local, mock)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.2

# --- Structured Document Intelligence (PoC 2.1) ---
# ANALYSIS_PROVIDER=mock
# ANALYSIS_MODEL=deepseek-chat
# ANALYSIS_MAX_CONTEXT_CHARS=120000
# ANALYSIS_MAX_IMPORTANT_DATES=10
# ANALYSIS_MAX_KEY_FACTS=20

