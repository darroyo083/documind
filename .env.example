# Application
APP_NAME=DocuMind
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind
DATABASE_URL_SYNC=postgresql://documind:documind@localhost:5432/documind

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# AI Generation Provider (deepseek, mock)
GENERATION_PROVIDER=mock
GENERATION_MODEL=mock-model
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# AI Embedding Provider (local, mock)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-model

# Retrieval
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.5
