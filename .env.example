# ANALYSIS_MAX_VALUE_LENGTH=500
# ANALYSIS_MAX_SUMMARY_LENGTH=2000
# ANALYSIS_MAX_SOURCES_PER_ITEM=8
# ANALYSIS_EXCERPT_CHARS=2000

